@page "/home"
@using drgndrop;
@using drgndrop.Services;
@inject IWebHostEnvironment Environment
@inject NavigationManager NavManager
@inject IJSRuntime JS
@inject UserService UserService

<PageTitle>Home</PageTitle>

<div class="container-fluid">
    @if (UserService.LoggedIn)
    {
        <h1>Welcome back @UserService.CurrentUser?.Name</h1>
    }

    <div class="row">
        <div class="col-lg mt-4">
            <h2>News</h2>
            <div class="list-group">
                @if(News.Count == null || News.Count <= 0)
                {
                    <div class="list-group-item bg-dark text-light">
                        <p>Nothing yet...</p>
                    </div>
                }
                else
                {
                    for(int i = 0; i < News.Count; ++i)
                    {
                        <div class="list-group-item text-light git-commit" style="@(i == 0 ? "background-color: #373d45" : "background-color: #212529" )">
                            <h3>@News[i].Title <small style="font-size: 1rem; color: #b5b5b5">@News[i].Creation.ToString()</small></h3>
                            <p>@((MarkupString)News[i].ShortDescription)</p>
                        </div>
                    }
                }
            </div>
        </div>
        <div class="col-lg mt-4">
            <h2>Git Updates</h2>
            <div class="list-group">
                @foreach(var commit in Git.Commits)
                {
                    if (Git.LocalSHA == commit.SHA)
                    {
                        <div class="list-group-item text-light git-commit" style="background-color: #373d45">
                            <p><a href="@commit.Author.URL"><img class="img-fluid rounded-circle git-author-avatar" width="32" height="32" src="@commit.Author.AvatarURL" /> @commit.Author.Name</a> : @commit.Message</p>
                        </div>
                    }
                    else
                    {
                        <div class="list-group-item bg-dark text-light git-commit">
                            <p><a href="@commit.Author.URL"><img class="img-fluid rounded-circle git-author-avatar" width="32" height="32" src="@commit.Author.AvatarURL" /> @commit.Author.Name</a> : @commit.Message</p>
                        </div>                
                    }
                }
            </div>
        </div>
    </div>
</div>

@code {
    public List<NewsEntry> News = new List<NewsEntry>();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            LoadNews();
        }

        await base.OnAfterRenderAsync(firstRender);
    }

    public async Task LoadNews()
    {
        DirectoryInfo directory = new DirectoryInfo(Program.NewsPath);

        FileInfo[] files = directory.GetFiles()
            .OrderByDescending(f => f.LastWriteTime)
            .Take(10)
            .ToArray();

        foreach (FileInfo file in files)
        {
            News.Add(NewsEntry.Parse(file));
        }

        StateHasChanged();
    }
}